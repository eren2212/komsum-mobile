{
  "expo": {
    "name": "SelamKomşu",
    "slug": "mobile",
    "scheme": "komsum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/komsum-appikon-turuncu.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logo/komsum-logo-turuncu.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ereniridere.SelamKomsu",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/komsum-appikon-turuncu-seffaf.png",
        "backgroundColor": "#FF6B4A"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.eren1247.mobile",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Komsum, galerinizdeki fotoğrafları seçmenize izin istiyor.",
          "cameraPermission": "Komsum, fotoğraf çekebilmek için kameraya erişmek istiyor."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Komsum, yakınındaki esnaf ve etkinlikleri gösterebilmek için konumunu kullanmak istiyor."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF6B4A",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "87f0b95e-49e2-490a-9a8d-8dc550dbba2b"
      }
    }
  }
}
